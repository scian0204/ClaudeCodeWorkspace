# ── Claude ────────────────────────────────────────────────
# Token precedence per turn: the author's OWN registered token → the admin-managed
# common token (set in the admin panel, encrypted in the DB) → this env fallback → mock.
# Prefer setting the common token from the admin panel; this env is only a bootstrap
# fallback used before an admin sets one. Accepts BOTH:
#   • a plain API key   → sk-ant-api...  (console.anthropic.com)
#   • an OAuth token     → sk-ant-oat...  (`claude setup-token`, Pro/Max login)
# The server auto-detects the prefix and wires the right env var for the CLI.
ANTHROPIC_API_KEY=
# Force mock for EVERY turn regardless of any token (dev): 1 | 0
MOCK_CLAUDE=0
# Key material for encrypting stored Claude tokens at rest (AES-256-GCM).
# CHANGE THIS in production. If empty, falls back to SESSION_SECRET. Changing it
# invalidates all stored tokens (users/admin re-register).
TOKEN_ENC_SECRET=change-me-token-encryption-secret
# Path to the claude-code executable (optional; SDK bundles one).
# CLAUDE_CODE_PATH=

# ── Privacy ───────────────────────────────────────────────
# Block every non-essential thing the Claude Code CLI sends to Anthropic: usage telemetry, error
# reports, /feedback + /bug + /share (which upload the whole transcript incl. code), the session
# quality survey and its transcript-upload follow-up, non-essential model calls, auto-updater pings,
# the WebFetch domain preflight (sends the hostname to api.anthropic.com), Artifact publishing,
# official-marketplace auto-install, and OpenTelemetry export. Injected into every agent subprocess
# and into newly started code-server editor containers. Default 1 (blocked); admin-toggleable live.
# This is the MASTER switch — the admin panel (Config → Privacy) also has one described toggle per
# channel, so a single one can be let back through (e.g. telemetry to your own OTel collector).
# The inference request itself (prompts + responses) is NOT affected — use LLM Provider = custom with
# a local Anthropic-compatible endpoint to remove that too. 1 | 0
BLOCK_NONESSENTIAL_TRAFFIC=1

# ── Server ────────────────────────────────────────────────
PORT=3000
# Where all tiers live (bind-mounted / named volume in Docker).
DATA_DIR=./data
# Session cookie signing secret. CHANGE THIS.
SESSION_SECRET=change-me-please-super-secret
# Global concurrent-turn cap across all sessions (shared key throttle).
MAX_CONCURRENT_TURNS=3
# PR-review: how often (ms) to poll each watched repo's host for open PRs. 0 disables polling
# (admins can still "refresh now" manually).
REVIEW_POLL_MS=60000
# PR-review: auto-run the pipeline (local merge → build/run → bug + code review → merge-safe
# verdict) when a new PR is detected. Set to 0 to require a manual trigger instead.
REVIEW_AUTO=1
# PR-review: post the finished review result back as a comment on the PR (uses the merge-capable
# credential). Set to 0 to keep reviews internal to the workspace and never comment on the remote.
REVIEW_COMMENT=1
# PR-review: accept inbound provider webhooks at /api/review/hooks/<repoId> so a PR event polls that
# repo immediately (each repo opts in from its edit dialog, which issues its secret). With webhooks
# set up you can run REVIEW_POLL_MS=0 and drop interval polling entirely. 0 makes the endpoint 404.
REVIEW_WEBHOOK=1
# PR-review build sandbox: review turns run the PR's build/test code in a locked-down sibling
# container (worktree-only mount, no docker socket) instead of the app container. Requires the
# Docker deployment (DATA_VOLUME/CODE_SERVER_NETWORK); falls back to host exec otherwise. The image
# must contain the toolchain you want buildable (default node); stacks it can't build are reviewed
# statically (no local build).
REVIEW_SANDBOX_IMAGE=node:20-bookworm
REVIEW_SANDBOX_MEM_MB=4096
REVIEW_SANDBOX_EXEC_TIMEOUT_MS=300000
# First-boot admin bootstrap (created only if no users exist).
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
# HTTPS (optional). Required for PWA "Install as app" off-localhost — browsers only
# treat localhost as a secure context. Point these at a browser-trusted cert (mkcert
# for LAN/IP, or Let's Encrypt with a domain); empty = plain HTTP. See README.
# TLS_KEY=/certs/key.pem
# TLS_CERT=/certs/cert.pem

# ── code-server ───────────────────────────────────────────
# Docker image used for editor containers.
CODE_SERVER_IMAGE=codercom/code-server:latest
# Idle timeout (ms) before a code-server container is reaped.
CODE_SERVER_IDLE_MS=1800000
# Docker network the app + code-server siblings share (compose sets this).
CODE_SERVER_NETWORK=
# Named volume holding /data on the host (for sibling mounts). In compose this
# is the project volume name, e.g. claudecode-workspace_data.
DATA_VOLUME=
